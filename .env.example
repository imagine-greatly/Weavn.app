# Copy this file to .env.local and fill in your values.

# Anthropic API Key (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Browserless Pro API key (https://www.browserless.io)
BROWSERLESS_API_KEY=your_browserless_api_key_here

# App URL (for links and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shown on /contact (mailto display)
NEXT_PUBLIC_CONTACT_EMAIL=hello@weavn.app

# Supabase (optional; for storing reports when using /api/scan)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Stripe — core
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_METER_WEBHOOK_SECRET=whsec_...

# Stripe price IDs — generated by `npx tsx scripts/setup-stripe.ts` (single source
# of truth = lib/pricing.ts, which reads quotas from lib/constants.ts). Paste the
# script's output here. Annual = 10x monthly. Metered prices bill per SCAN.

# Dashboard track (flat monthly + annual)
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_ANNUAL=price_...

# API track (flat base monthly + annual, plus metered scan-count overage)
STRIPE_PRICE_DEV_BASE_MONTHLY=price_...
STRIPE_PRICE_DEV_BASE_ANNUAL=price_...
STRIPE_PRICE_DEV_METERED=price_...
STRIPE_PRICE_BUILDER_BASE_MONTHLY=price_...
STRIPE_PRICE_BUILDER_BASE_ANNUAL=price_...
STRIPE_PRICE_BUILDER_METERED=price_...
STRIPE_PRICE_SCALE_BASE_MONTHLY=price_...
STRIPE_PRICE_SCALE_BASE_ANNUAL=price_...
STRIPE_PRICE_SCALE_METERED=price_...
STRIPE_PRICE_PLAYGROUND_METERED=price_...

# Metered billing meter (also printed by setup-stripe). Counts api_scan units.
STRIPE_API_SCAN_METER_ID=mtr_...

# Legacy single-price wiring — still read as a fallback for Pro/Agency monthly.
# Safe to remove once the slots above are populated.
STRIPE_PRO_PRICE_ID=price_...
STRIPE_AGENCY_PRICE_ID=price_...
